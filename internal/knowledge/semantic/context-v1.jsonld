{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "k": "urn:polaroid:k:",
    "pc": "urn:polaroid:corpus:",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "Domain": "pc:Domain",
    "Concept": "skos:Concept",
    "Claim": "pc:Claim",
    "Rule": "pc:Rule",
    "Procedure": "pc:Procedure",
    "Evidence": "pc:Evidence",
    "Exception": "pc:Exception",
    "label": "skos:prefLabel",
    "definition": "skos:definition",
    "statement": "pc:statement",
    "classified_as": {"@id": "dcterms:subject", "@type": "@id", "@container": "@set"},
    "broader": {"@id": "skos:broader", "@type": "@id", "@container": "@set"},
    "specializes": {"@id": "pc:specializes", "@type": "@id", "@container": "@set"},
    "uses": {"@id": "pc:uses", "@type": "@id", "@container": "@set"},
    "composes": {"@id": "pc:composes", "@type": "@id", "@container": "@set"},
    "precedes": {"@id": "pc:precedes", "@type": "@id", "@container": "@set"},
    "requires": {"@id": "pc:requires", "@type": "@id", "@container": "@set"},
    "supports": {"@id": "pc:supports", "@type": "@id", "@container": "@set"},
    "contradicts": {"@id": "pc:contradicts", "@type": "@id", "@container": "@set"},
    "supersedes": {"@id": "dcterms:replaces", "@type": "@id", "@container": "@set"},
    "asserts": {"@id": "pc:asserts", "@container": "@set"},
    "subject": "pc:subject",
    "predicate": "pc:predicate",
    "object": "pc:object",
    "source": "dcterms:bibliographicCitation",
    "program": "pc:program",
    "revision": "pc:revision",
    "protected": "pc:protected",
    "waivable": "pc:waivable",
    "inputs": {"@id": "pc:input", "@container": "@set"},
    "outputs": {"@id": "pc:output", "@container": "@set"},
    "name": "pc:name",
    "concept": {"@id": "pc:concept", "@type": "@id"},
    "outputs_complete": "pc:outputsComplete",
    "preconditions": {"@id": "pc:precondition", "@type": "@id", "@container": "@set"},
    "postconditions": {"@id": "pc:postcondition", "@type": "@id", "@container": "@set"},
    "invariants": {"@id": "pc:invariant", "@type": "@id", "@container": "@set"},
    "informal_conditions": {"@id": "pc:informalCondition", "@container": "@set"},
    "preconditions_complete": "pc:preconditionsComplete",
    "postconditions_complete": "pc:postconditionsComplete",
    "invariants_complete": "pc:invariantsComplete",
    "informal_conditions_complete": "pc:informalConditionsComplete",
    "excepts": {"@id": "pc:excepts", "@type": "@id", "@container": "@set"},
    "rule_digest": "pc:ruleDigest",
    "applies_to": {"@id": "pc:appliesTo", "@type": "@id", "@container": "@set"},
    "conditions": {"@id": "pc:condition", "@container": "@set"},
    "value": "pc:value",
    "waives": {"@id": "pc:waives", "@type": "@id"},
    "replacement": {"@id": "pc:replacement", "@type": "@id"},
    "justification": "pc:justification",
    "authority": {"@id": "pc:authority"},
    "level": "pc:level",
    "domain": {"@id": "pc:domain", "@type": "@id"},
    "repository": "pc:repository",
    "path": {"@id": "pc:path", "@type": "@id", "@container": "@list"},
    "approval": {"@id": "pc:approval"},
    "reference": "pc:reference",
    "key": "pc:key",
    "valid_from": {"@id": "pc:validFrom", "@type": "xsd:dateTime"},
    "valid_until": {"@id": "pc:validUntil", "@type": "xsd:dateTime"},
    "signature": "pc:signature"
  }
}
